# Postgres (used by docker-compose to build DATABASE_URL and the bot's
# PGHOST/PGUSER/... vars automatically — shared by the db, app and bot services)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Only needed for local dev without docker-compose (compose builds this for you from the vars above)
DATABASE_URL=

# Telegram bot token — used by the app for admin notifications (HTTP API)
# and by the bot service for long polling (BOT_TOKEN); same token, both services
TELEGRAM_BOT_TOKEN=

# Google reCAPTCHA v3 keys
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# Public URL of the site (used for NUXT_PUBLIC_SITE_URL — affects whether
# the auth cookie's Secure flag logic and any absolute links are correct)
SITE_URL=https://your-domain.com

# Secret used to sign admin JWT auth cookies
JWT_SECRET=

# Groq API key (used by the chat bot)
GROQ_API_KEY=
